{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix web",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:page(|calculators|draws|analytics|checklists|processing-times|timeline|features|guides|crs-points|improve-crs-score|language-tests-clb|fsw-67-points|express-entry-draws|express-entry-process|about|privacy|terms)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/:page(index|calculators|draws|analytics|checklists|processing-times|timeline|features|guides|crs-points|improve-crs-score|language-tests-clb|fsw-67-points|express-entry-draws|express-entry-process|about|privacy|terms).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
