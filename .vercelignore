# The Vercel build renders only the static marketing site: web/build.mjs reads web/,
# docs/*.md, data/*.json and two of the app's data files, and middleware.js handles content negotiation.
# The rest of the monorepo — the Expo app (~800 MB with its native dirs) and the
# Cloudflare Worker — is dead weight that aborted `vercel deploy` mid-upload at 226 MB.
# Allowlist, so a new top-level workspace can never silently re-inflate the tarball.
/*
!/web
!/docs
!/data
!/middleware.js
!/vercel.json
# The two app data files the site's checklists and processing-times pages import.
!/mobile
/mobile/*
!/mobile/src
/mobile/src/*
!/mobile/src/features
/mobile/src/features/*
!/mobile/src/features/checklist
/mobile/src/features/checklist/*
!/mobile/src/features/checklist/data
!/mobile/src/features/tracker
/mobile/src/features/tracker/*
!/mobile/src/features/tracker/data

# Build inputs only — the output dir is generated on Vercel.
/web/node_modules
/web/public
