# Cloudflare Worker URL (no trailing slash)
EXPO_PUBLIC_PUSH_URL=https://crs-pulse-push.balwinderxcode.workers.dev

# Push worker API key — must match `wrangler secret put PUSH_API_SECRET`
EXPO_PUBLIC_PUSH_API_KEY=

# EAS project ID (from `eas init` or expo.dev dashboard)
EAS_PROJECT_ID=

# App Store Connect numeric app ID (for in-app review link, optional until live)
EXPO_PUBLIC_APP_STORE_ID=

# Privacy policy URL (defaults to GitHub — no custom domain needed)
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://github.com/BalwinderCa/crs-pulse/blob/main/docs/PRIVACY_POLICY.md

# Master monetization toggle — set to true to enable ads + IAP. When false
# (default) the app ships fully free with no ads and all features unlocked.
# EXPO_PUBLIC_MONETIZATION_ENABLED=true

# Optional crash/error collector endpoint. Unset = local-only (no data leaves
# the device). When set, uncaught errors POST {message,stack,version,platform}
# — never CRS inputs or user data.
# EXPO_PUBLIC_ERROR_REPORT_URL=

# ── Google AdMob (banner ads for free users; Premium removes them) ────────────
# All optional — unset = Google's public TEST ids (test ads always fill). Set
# these to your real AdMob ids for production. NOTE: dev builds always serve TEST
# ads regardless of these values (clicking your own LIVE ads gets AdMob accounts
# banned), so real ads only appear in a release/production build. Changing any of
# these is a NATIVE config change → requires a rebuild, not just a Metro reload.
#
# App ids (admob.google.com → your app → App settings), format ca-app-pub-…~…
# GOOGLE_ADMOB_ANDROID_APP_ID=
# GOOGLE_ADMOB_IOS_APP_ID=
# Banner ad-unit ids (AdMob → your app → Ad units → Banner), format ca-app-pub-…/…
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
# EXPO_PUBLIC_ADMOB_BANNER_IOS=
