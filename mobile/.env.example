# Cloudflare Worker URL (no trailing slash)
EXPO_PUBLIC_PUSH_URL=https://crs-pulse-push.balwinderxcode.workers.dev

# Push worker API key — must match `wrangler secret put PUSH_API_SECRET`
EXPO_PUBLIC_PUSH_API_KEY=

# EAS project ID (from `eas init` or expo.dev dashboard)
EAS_PROJECT_ID=

# App Store Connect numeric app ID (for in-app review link, optional until live)
EXPO_PUBLIC_APP_STORE_ID=

# Privacy policy URL (defaults to GitHub — no custom domain needed)
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://github.com/BalwinderCa/crs-pulse/blob/main/docs/PRIVACY_POLICY.md
