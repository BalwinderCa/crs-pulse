#!/usr/bin/expect -f
set timeout 180
cd [file dirname [info script]]/..

proc down {} { send "\x1b\[B" }
proc enter {} { send "\r" }

spawn npx eas-cli credentials -p android

expect "Which build profile do you want to configure?"
down
down
enter
expect "Using build profile: production"
sleep 1

expect "Keystore: Manage everything needed to build your project"
down
enter
sleep 1

expect "Manage your Google Service Account Key for Play Store Submissions"
down
enter
sleep 1

expect "Set up a Google Service Account Key for Push Notifications"
enter

expect {
    "Google Service Account Key for FCM V1 already set up." {
        puts "\nFCM key already configured"
        exit 0
    }
    "Select the Google Service Account Key to use for FCM V1:" {
        # Prefer an existing uploaded key (1st option)
        enter
        exp_continue
    }
    "Select a Google Service Account Key:" {
        enter
        exp_continue
    }
    "Would you like to use this file?" {
        send "y"
        enter
        exp_continue
    }
    "Google Service Account Key assigned" {
        puts "\nFCM key assigned to com.crspulse.app"
        exit 0
    }
    timeout {
        puts "\nTIMEOUT during FCM setup"
        exit 1
    }
}
