{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal"
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_PUSH_URL": "https://crs-pulse-push.balwinderxcode.workers.dev",
        "EXPO_PUBLIC_PUSH_API_KEY": "dummy_secret_for_preview_replace_in_eas_secrets"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "ios": {
        "distribution": "store",
        "credentialsSource": "remote",
        "image": "macos-sequoia-15.6-xcode-26.0"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_PUSH_URL": "https://crs-pulse-push.balwinderxcode.workers.dev",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "GOOGLE_ADMOB_IOS_APP_ID": "ca-app-pub-4874088724567128~5855067683",
        "EXPO_PUBLIC_ADMOB_BANNER_IOS": "ca-app-pub-4874088724567128/3926908348",
        "EXPO_PUBLIC_ADMOB_NATIVE_IOS": "ca-app-pub-4874088724567128/2521223683",
        "EXPO_PUBLIC_MONETIZATION_ENABLED": "true"
      }
    },
    "production-apk": {
      "extends": "production",
      "autoIncrement": false,
      "environment": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "balwinder98.ca@gmail.com",
        "ascAppId": "6784619403"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
