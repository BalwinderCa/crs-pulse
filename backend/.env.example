APP_NAME="CRS Pulse API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Toronto

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_CA

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=crs_pulse
DB_USERNAME=crs_user
DB_PASSWORD=crs_secret
DB_ROOT_PASSWORD=root_secret

CACHE_STORE=redis
CACHE_PREFIX=crs_pulse

QUEUE_CONNECTION=redis

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@crspulse.ca"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000
SANCTUM_TOKEN_EXPIRY_DAYS=30

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=storage/firebase-credentials.json

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# IRCC Data source (for scheduled scraping/parsing)
IRCC_DRAWS_URL=https://www.canada.ca/en/immigration-refugees-citizenship/services/immigrate-canada/express-entry/submit-profile/rounds-invitations.html

# Filament Admin
FILAMENT_ADMIN_EMAIL=admin@crspulse.ca
FILAMENT_ADMIN_PASSWORD=change_me_in_production

# Analytics cache TTL (seconds)
ANALYTICS_CACHE_TTL=3600
DRAWS_CACHE_TTL=300
